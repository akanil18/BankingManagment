# ─────────────────────────────────────────
#  AI TRAINING — example.env
#  Copy this file to .env and fill values
# ─────────────────────────────────────────

# HuggingFace
HF_TOKEN=your-huggingface-token-here
HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# PostgreSQL (same DB as backend)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/banking_db

# Training output
OUTPUT_DIR=./output/qwen-banking-lora
MERGED_MODEL_DIR=./output/qwen-banking-merged
GGUF_OUTPUT_DIR=../ai-server/models

# QLoRA Hyperparameters
LORA_RANK=16
LORA_ALPHA=16
LORA_DROPOUT=0.0
MAX_SEQ_LENGTH=2048
BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=2e-4
NUM_EPOCHS=3
WARMUP_RATIO=0.1
FP16=true

# Dataset split
TRAIN_SPLIT=0.9
EVAL_SPLIT=0.1

# GGUF quantization
GGUF_QUANTIZATION=Q4_K_M
