# ─────────────────────────────────────────
#  BACKEND — example.env
#  Copy this file to .env and fill values
# ─────────────────────────────────────────

# App
APP_NAME=BankingManagementSystem
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/banking_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (rate limiting + caching)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10

# llama-server (AI model)
LLAMA_SERVER_URL=http://localhost:8080/v1
LLAMA_MODEL_NAME=qwen-banking
LLAMA_MAX_TOKENS=1024
LLAMA_TEMPERATURE=0.1

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=xlsx,xls,csv
UPLOAD_DIR=./uploads

# CORS (Vue.js frontend)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Agent
AGENT_TOP_K_RESULTS=5
AGENT_MAX_CONVERSATION_HISTORY=20
