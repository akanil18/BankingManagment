# ─────────────────────────────────────────
#  FRONTEND — example.env
#  Copy this file to .env and fill values
#  All vars must start with VUE_APP_
# ─────────────────────────────────────────

# Backend API base URL
VUE_APP_API_URL=http://localhost:8000/api

# App
VUE_APP_NAME=Banking Management System
VUE_APP_VERSION=1.0.0

# Token storage key (localStorage)
VUE_APP_TOKEN_KEY=bms_access_token
VUE_APP_REFRESH_TOKEN_KEY=bms_refresh_token

# Agent
VUE_APP_AGENT_POLLING_INTERVAL_MS=1000
VUE_APP_MAX_CHAT_MESSAGES=100

# Pagination
VUE_APP_TABLE_PAGE_SIZE=50
